ARG FT_BASE_IMAGE
FROM ${FT_BASE_IMAGE}
USER root

LABEL org.opencontainers.image.title="FreeToken platform SGLang launch adapter" \
      io.freetoken.platform.adapter="sglang-cli-to-ft-serve"

RUN test -x /opt/venv/bin/python3 && test -x /opt/venv/bin/ft && test -x /usr/bin/tini \
    && test -x /usr/local/bin/freetoken-healthcheck \
    && /opt/venv/bin/python3 -c 'from freetoken.platform_sglang import main; from freetoken.models.qwen4_exp.weight import shard_dense_tensor'

RUN mkdir -p /opt/freetoken-platform/sglang \
    && printf '%s\n' '"""Platform launch namespace; no SGLang engine."""' > /opt/freetoken-platform/sglang/__init__.py \
    && printf '%s\n' 'from freetoken.platform_sglang import main' 'if __name__ == "__main__":' '    main()' \
       > /opt/freetoken-platform/sglang/launch_server.py \
    && printf '%s\n' '#!/bin/sh' 'set -eu' \
       'if [ "$#" -eq 0 ]; then exec /opt/venv/bin/python3 -m sglang.launch_server; fi' \
       'case "$1" in' \
       '    serve) shift; exec /opt/venv/bin/python3 -m sglang.launch_server "$@" ;;' \
       '    -*) exec /opt/venv/bin/python3 -m sglang.launch_server "$@" ;;' \
       '    *) exec "$@" ;;' \
       'esac' > /usr/local/bin/freetoken-platform-entrypoint \
    && chmod 0755 /usr/local/bin/freetoken-platform-entrypoint

ENV PYTHONPATH=/opt/freetoken-platform \
    PORT=8000 \
    HOST=0.0.0.0 \
    MODEL_PATH=/mnt/Qwen3.8-Flash-Next-NVFP4 \
    SERVED_MODEL_NAME=Qwen3.8-Flash-Next-NVFP4 \
    LOG_LEVEL=INFO \
    FT_MAX_RUNNING_REQUESTS=2 \
    FT_MAX_SEQ_LEN=16384 \
    FT_MAX_OUTPUT_TOKENS=2048 \
    FT_MAX_PREFILL_LENGTH=4096 \
    FT_KV_RESERVE_TOKENS=32768 \
    FT_MEMORY_RATIO=0.90 \
    FT_DISTRIBUTED_TIMEOUT=1800 \
    FT_PLE_BACKEND=disk \
    FT_COMM_BACKEND=torch \
    TINI_SUBREAPER=1

RUN /opt/venv/bin/python3 -m sglang.launch_server --help

USER 10001:10001
EXPOSE 8000
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s --timeout=5s --start-period=60m --retries=3 \
    CMD ["/usr/local/bin/freetoken-healthcheck", "ready"]
ENTRYPOINT ["/usr/bin/tini", "-s", "-g", "--", "/usr/local/bin/freetoken-platform-entrypoint"]
CMD []
